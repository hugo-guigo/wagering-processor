{
  "name": "wagering-processor",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/main.ts",
    "migrate": "bun run scripts/migrate.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "LOG_LEVEL=error bun test test/unit",
    "test:integration": "LOG_LEVEL=error bun test test/integration",
    "test:concurrency": "LOG_LEVEL=error bun test test/concurrency"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1161.0",
    "@mikro-orm/core": "7.2.7",
    "@mikro-orm/migrations": "7.2.7",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.2.7",
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-express": "12.3.3",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
